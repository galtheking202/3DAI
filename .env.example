# --- Core ---
DATABASE_URL="postgresql://threedai:threedai@localhost:5432/threedai?schema=public"
APP_URL="http://localhost:3000"
SESSION_COOKIE="sid"

# --- Email (magic-link sign in) ---
# console  -> link is printed to the server log (default for local dev)
# smtp     -> sent via SMTP settings below (MailHog defaults included)
# resend   -> sent via the Resend API using RESEND_API_KEY
EMAIL_TRANSPORT="console"
EMAIL_FROM="3DAI <no-reply@localhost>"
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
RESEND_API_KEY=""

# --- Object storage (MinIO locally, Cloudflare R2 in production) ---
# Used from milestone 2 onward.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="auto"
S3_ACCESS_KEY_ID="minio"
S3_SECRET_ACCESS_KEY="minio12345"
S3_BUCKET="3dai-media"
S3_FORCE_PATH_STYLE="true"

# --- 3D generation engine ---
# mock   -> returns a bundled sample asset after a short delay (current default)
# atlas  -> World Labs Atlas API (not implemented)
# meshy  -> Meshy multi-image-to-3D API (needs MESHY_API_KEY); generative, best for OBJECT scenes
# kiri   -> KIRI Engine photogrammetry (needs KIRI_API_KEY); measured reconstruction from a
#           walkthrough video or >=20 photos; handles objects, spaces and vehicles
GENERATOR="mock"

# Meshy API — only read when GENERATOR=meshy.
MESHY_API_KEY=""
MESHY_AI_MODEL="meshy-5"          # or "latest" for best quality (costs more credits)
MESHY_TEXTURE_RESOLUTION="2k"     # 2k | 4k | 8k

# KIRI Engine API — only read when GENERATOR=kiri.
KIRI_API_KEY=""
KIRI_MODEL_QUALITY="1"            # 0 High | 1 Medium | 2 Low | 3 Ultra
KIRI_TEXTURE_QUALITY="1"          # 0 4K | 1 2K | 2 1K | 3 8K
KIRI_MASK="true"                  # auto-mask the object out of its background

# --- Ads (Google AdSense banner under the model on /s/<slug> share pages) ---
# ADS_ENABLED is the master switch. With ADS_ENABLED + ADS_CLIENT the
# adsbygoogle.js loader ships in <head> site-wide (enough for Google to review
# and verify the site). The banner under the model appears once ADS_SLOT is
# also set. Owners never see ads on their own dashboard.
ADS_ENABLED="false"
ADS_CLIENT="ca-pub-2736337749949250"  # AdSense publisher ID
ADS_SLOT=""                           # display ad unit ID, e.g. 1234567890

# --- Generation worker (npm run worker) ---
WORKER_POLL_INTERVAL_MS="2000"   # queue poll cadence when idle
WORKER_MAX_ATTEMPTS="3"          # tries per job before it goes FAILED
MOCK_GENERATOR_MIN_MS="2500"     # mock engine: shortest simulated run
MOCK_GENERATOR_MAX_MS="6000"     # mock engine: longest simulated run
