# --- Core ---
DATABASE_URL="postgresql://threedai:threedai@localhost:5432/threedai?schema=public"
APP_URL="http://localhost:3000"
SESSION_COOKIE="sid"

# --- Email (magic-link sign in) ---
# console  -> link is printed to the server log (default for local dev)
# smtp     -> sent via SMTP settings below (MailHog defaults included)
EMAIL_TRANSPORT="console"
EMAIL_FROM="3DAI <no-reply@localhost>"
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""

# --- Object storage (MinIO locally, Cloudflare R2 in production) ---
# Used from milestone 2 onward.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="auto"
S3_ACCESS_KEY_ID="minio"
S3_SECRET_ACCESS_KEY="minio12345"
S3_BUCKET="3dai-media"
S3_FORCE_PATH_STYLE="true"

# --- 3D generation engine ---
# mock   -> returns a bundled sample asset after a short delay (current)
# atlas  -> World Labs Atlas API (not yet available)
GENERATOR="mock"
